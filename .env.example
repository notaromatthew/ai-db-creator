# Copia questo file in .env e inserisci solo le credenziali del provider scelto.
LLM_PROVIDER=google
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
SOFTWARE_REVISION=unknown

# Required by docker-compose. Use long values from the deployment secret store;
# REDIS_PASSWORD must be URL-safe. Never commit the real values.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Conservative throttle for the test provider capped at 10 requests/minute.
LLM_MAX_REQUESTS_PER_MINUTE=8
