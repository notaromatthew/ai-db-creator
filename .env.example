# Copia questo file in .env e inserisci solo le credenziali del provider scelto.
LLM_PROVIDER=google
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
SOFTWARE_REVISION=unknown
