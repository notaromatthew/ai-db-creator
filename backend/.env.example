# Copia questo file in .env e imposta il provider e la chiave scelti.
LLM_PROVIDER=google

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# groq
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# google gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite

# ollama (locale)
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3