# Copia questo file in .env e imposta il provider e la chiave scelti.
LLM_PROVIDER=google

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# groq
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# google gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite

# ollama (locale o endpoint approvato esplicitamente)
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

OLLAMA_MODEL=gemma2:9b

# Redis / Celery (necessari per i task asincroni)
REDIS_URL=redis://:replace-with-url-safe-password@localhost:6379/0
TASK_REGISTRY_TTL_SECONDS=3600

# Draft three-arm experiment mode (keep false outside an approved study protocol)
EXPERIMENT_MODE=false
EXPERIMENT_ASSIGNMENT_SEED=replace-before-pilot
EXPERIMENT_PSEUDONYM_SECRET=replace-before-pilot
RQ4_HASH_SALT=replace-before-pilot
BOOTSTRAP_KEYCLOAK=false
