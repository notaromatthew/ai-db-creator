# Copia questo file in .env e imposta il provider e la chiave scelti.
LLM_PROVIDER=google
STUDY_QUESTIONNAIRES_ENABLED=false

# pannello amministratore della valutazione esperti: obbligatoria, senza valore predefinito
ADMIN_SECRET_KEY=

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# groq
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SCHEMA_JSON_MODE=false

# google gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
GOOGLE_MAX_RETRIES=0
GOOGLE_TIMEOUT_SECONDS=120

# ollama (remoto)
USE_OLLAMA=false
OLLAMA_BASE_URL=https://ollamaapi-u11fj34m2h9druz26hamz3xb.89.168.29.98.sslip.io
OLLAMA_API_KEY=

OLLAMA_MODEL=gemma2:9b
