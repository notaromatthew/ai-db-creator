# Deploy RICERCA su Coolify. Stesso compose del prodotto (docker-compose.coolify.yml), valori diversi.
APP_PUBLIC_URL=https://aidb-research.paas.tecniaweb.it
RESEARCH_MODE=true
KEYCLOAK_CLIENT_ID=aidbcreator-research
KEYCLOAK_URL=https://auth.paas.tecniaweb.it
KEYCLOAK_REALM=aidbcreator
DATABASE_URL=postgresql://<utente>:<password>@<host-postgres>:5432/aidb_ricerca
REDIS_PASSWORD=<openssl rand -hex 24, diversa dal prodotto>
KEYCLOAK_ADMIN_USER=<segreto>
KEYCLOAK_ADMIN_PASSWORD=<segreto>
FIRST_ADMIN_EMAIL=<email del primo amministratore>
STUDY_ACCOUNT_SALT=<openssl rand -hex 24, solo ricerca>
VERTEX_CREDENTIALS_JSON=<contenuto di vertex-prod-sa.json, segreto>
VERTEX_ALLOWED_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
DAILY_AI_BUDGET_TOTAL=150
DEFAULT_DAILY_AI_QUOTA=10
