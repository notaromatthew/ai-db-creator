# Deploy RICERCA su Coolify. Password di Postgres, Redis e sale dello studio le genera Coolify (SERVICE_PASSWORD_*).
APP_PUBLIC_URL=https://aidb-research.paas.tecniaweb.it
RESEARCH_MODE=true
KEYCLOAK_CLIENT_ID=aidbcreator-research
KEYCLOAK_REALM=aidbcreator
FIRST_ADMIN_EMAIL=<email del primo amministratore>
VERTEX_ALLOWED_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
DAILY_AI_BUDGET_TOTAL=150
DEFAULT_DAILY_AI_QUOTA=10
# Segreti condivisi (Shared Variables del team in Coolify, valore {{team.NOME}} nella risorsa):
KEYCLOAK_ADMIN_USER={{team.KEYCLOAK_ADMIN_USER}}
KEYCLOAK_ADMIN_PASSWORD={{team.KEYCLOAK_ADMIN_PASSWORD}}
VERTEX_CREDENTIALS_JSON={{team.VERTEX_CREDENTIALS_JSON}}
