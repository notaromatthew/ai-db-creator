terraform {
  required_version = ">= 1.6"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
  # Fase 1: stato locale (file ignorato da git). Si passa a un bucket GCS in seguito.
  backend "local" {}
}
