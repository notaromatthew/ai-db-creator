  "functional_queries": [
    {
      "id": "U01",
      "description": "Numero di iscrizioni osservabili",
      "critical": true,
      "sql": "SELECT COUNT(*) AS enrollment_count FROM enrollments",
      "comparison": {
        "mode": "scalar",
        "columns": [
          "enrollment_count"
        ]
      }
    },
    {
      "id": "U02",
      "description": "Studenti presenti nelle iscrizioni con identità di business",
      "critical": true,
      "sql": "SELECT DISTINCT s.email, s.name FROM students s JOIN enrollments e ON e.student_id = s.student_id",
      "comparison": {
        "mode": "unordered_rows",
        "columns": [
          "email",
          "name"
        ]
      }
    },
    {
      "id": "U03",
      "description": "Catalogo dei corsi effettivamente referenziati",
      "critical": true,
      "sql": "SELECT DISTINCT c.course_code, c.title, c.credits FROM courses c JOIN enrollments e ON e.course_id = c.course_id",
      "comparison": {
        "mode": "unordered_rows",
        "columns": [
          "course_code",
          "title",
          "credits"
        ]
      }
    },
    {
      "id": "U04",
      "description": "Fatti completi di iscrizione indipendenti dagli ID sintetici",
      "critical": true,
      "sql": "SELECT s.email, c.course_code, e.semester, e.grade FROM enrollments e JOIN students s ON s.student_id = e.student_id JOIN courses c ON c.course_id = e.course_id",
      "comparison": {
        "mode": "unordered_rows",
        "columns": [
          "email",
          "course_code",
          "semester",
          "grade"
        ]
      }
    },
    {
      "id": "U05",
      "description": "Numero di iscrizioni per corso",
      "critical": false,
      "sql": "SELECT c.course_code, COUNT(*) AS enrollment_count FROM enrollments e JOIN courses c ON c.course_id = e.course_id GROUP BY c.course_code",
      "comparison": {
        "mode": "unordered_rows",
        "columns": [
          "course_code",
          "enrollment_count"
        ]
      }
    },
    {
      "id": "U06",
      "description": "Numero di iscrizioni per semestre",
      "critical": false,
      "sql": "SELECT semester, COUNT(*) AS enrollment_count FROM enrollments GROUP BY semester",
      "comparison": {
        "mode": "unordered_rows",
        "columns": [
          "semester",
          "enrollment_count"
        ]
      }
    },
    {
      "id": "U07",
      "description": "Carico di corsi per studente osservato",
      "critical": false,
      "sql": "SELECT s.email, COUNT(*) AS course_count FROM enrollments e JOIN students s ON s.student_id = e.student_id GROUP BY s.email",
      "comparison": {
        "mode": "unordered_rows",
        "columns": [
          "email",
          "course_count"
        ]
      }
    },
    {
      "id": "U08",
      "description": "Distribuzione dei voti",
      "critical": false,
      "sql": "SELECT grade, COUNT(*) AS grade_count FROM enrollments GROUP BY grade",
      "comparison": {
        "mode": "unordered_rows",
        "columns": [
          "grade",
          "grade_count"
        ]
      }
    },
    {
      "id": "U09",
      "description": "Crediti associati a ciascun corso referenziato",
      "critical": false,
      "sql": "SELECT course_code, credits FROM courses",
      "comparison": {
