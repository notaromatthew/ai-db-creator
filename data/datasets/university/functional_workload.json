      "ordered": false,
      "sql": "SELECT student_id, name, email FROM students WHERE email = 'student1@university.example'",
      "expected": {
        "columns": [
          "student_id",
          "name",
          "email"
        ],
        "rows": [
          [
            1,
            "Federico Ferrari",
            "student1@university.example"
          ]
        ]
      }
    },
